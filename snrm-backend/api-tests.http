### 58. The topological metric suite. Expect 200, and exactly these values —
# every one of them derived by hand in docs/metric-verification.md:
#
#   DENSITY              0.23333333333333334   (7 / 30)
#   SPOF_NODE_COUNT      3
#   SPOF_ARC_COUNT       3
#   SPOF_COUNT           6
#   AVG_PATH             1.6153846153846154    (21 / 13)
#   CLUSTERING           0.3888888888888889    (7 / 18)
#   NODE_CRITICALITY     SUP-1   1.0
#                        PLANT-1 1.0
#                        DC-1    0.6153846153846154   (8 / 13)
#                        DC-2    0.0
#                        CUST-1  0.6153846153846154   (8 / 13)
#                        CUST-2  0.38461538461538464  (5 / 13)
#   ROBUSTNESS_RANDOM    0.35648148148148145   (77 / 216)
#   ROBUSTNESS_TARGETED  0.3888888888888889    (7 / 18)
#
# Fourteen rows: eight network-scoped, six NODE-scoped criticalities, in the
# suite order listed above — density and the three single-point-of-failure
# figures lead it. Every row has runId=null, ciLow=null and
# ciHigh=null (exact, not aggregated), and displayUnit=null (nothing
# here is time-valued).
#
# Rt above Rr is not a defect; §7 of the verification document explains it.
GET {{baseUrl}}/networks/{{metricNetworkId}}/metrics/topological
Authorization: Bearer {{token}}

### 58b. Call it again. Expect 200 with the same values and the same row count —
# a recompute replaces the network's run-less rows rather than adding to them.
# The `id`s change, which is the visible sign of the replacement.
GET {{baseUrl}}/networks/{{metricNetworkId}}/metrics/topological
Authorization: Bearer {{token}}

### 58c. The suite for a network that does not exist. Expect 404, code NOT_FOUND.
GET {{baseUrl}}/networks/999999/metrics/topological
Authorization: Bearer {{token}}


###############################################################################
# SIMULATION — the engine and the simulated metric suite.
#
# Requests 60-68 import the three-node chain of docs/simulation-verification.md,
# define its one deterministic disruption, run it with a fixed seed and one
# replication, and fetch results whose every value that document derives by hand.
# If a number here disagrees with §8 of that document, one of the two is wrong
# and the document is the specification.
###############################################################################

### 60. Import samples/simulation-verification-3-node/. Expect 200 with
# committed: true, 3 nodes, 2 links, 1 product, 3 node-product rows and no
# findings — every duration is a whole number of days on a 1-day period.
# @name importSimulationSample
POST {{baseUrl}}/networks/import
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=SNRM

--SNRM
Content-Disposition: form-data; name="projectId"

{{projectId}}
--SNRM
